<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ 备份/迁移规则：纯本地应用，不参与任何云端备份或设备迁移 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
